<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
    <children>
        <VBox spacing="16.0" alignment="CENTER">
            <children>
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="backButton" text="Back" onAction="#switchToHome" />
                        <Label text="Login" />
                    </children>
                </HBox>

                <TextField fx:id="usernameField" promptText="Username" maxWidth="260.0" />
                <PasswordField fx:id="passwordField" promptText="Password" maxWidth="260.0" />
                <Button fx:id="loginButton" text="Login" />
            </children>
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
