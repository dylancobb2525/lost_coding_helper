<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="screen-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.HomeController">
   <children>
      <VBox fx:id="welcomePane" alignment="CENTER" spacing="28.0" styleClass="welcome-stack">
         <children>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label styleClass="title-lots" text="LOTS" />
                  <Label styleClass="subtitle-app" text="Lord of the Strings - Coding Helper" wrapText="true" textAlignment="CENTER" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="16.0" maxWidth="280.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToLogin" styleClass="button-pill-primary" text="Log in" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToSignUp" styleClass="button-pill-outline" text="Sign up" />
                  <VBox alignment="CENTER" spacing="4.0">
                     <children>
                        <Hyperlink onAction="#continueAsGuest" styleClass="link-guest" text="Continue as guest" />
                        <Label styleClass="hint-muted" text="(not in Java backend yet)" textAlignment="CENTER" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="32.0" left="28.0" right="28.0" top="48.0" />
         </padding>
      </VBox>
      <VBox fx:id="dashboardPane" alignment="TOP_CENTER" spacing="16.0" styleClass="dashboard-stack" visible="false" managed="false">
         <children>
            <Label fx:id="dashboardGreeting" styleClass="dashboard-heading" text="Home" />
            <Label styleClass="hint-muted" text="Dashboard UI coming soon — you are signed in." textAlignment="CENTER" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="32.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
   </padding>
</StackPane>
