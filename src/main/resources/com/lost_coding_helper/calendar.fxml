            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="18.0" styleClass="nav-bar">
               <children>
                  <Button mnemonicParsing="false" onAction="#navLeaderboard" styleClass="nav-icon">
