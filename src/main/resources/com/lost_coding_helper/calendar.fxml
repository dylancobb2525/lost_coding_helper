                        <SVGPath styleClass="nav-svg" content="M12 12a4 4 0 1 0-0.001-8A4 4 0 0 0 12 12Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z" />
