<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane styleClass="screen-root calendar-screen"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.CalendarController">

    <children>
        <VBox spacing="0.0">
            <children>

                <!-- Main Content (scrollable; keeps bottom nav fixed) -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="22.0" alignment="TOP_CENTER">
                            <children>

                        <!-- Title -->
                        <Label text="Study Planner" styleClass="calendar-title">
                            <VBox.margin>
                                <Insets top="54.0"/>
                            </VBox.margin>
                        </Label>

                        <Label fx:id="todayDateHeaderLabel" styleClass="calendar-today-header" text="Today:">
                            <VBox.margin>
                                <Insets top="6.0"/>
                            </VBox.margin>
                        </Label>

                        <!-- Calendar Grid (CENTERED) -->
                        <GridPane hgap="6.0" vgap="10.0" alignment="CENTER">
                            <children>

                                <!-- Row 1 -->
                                <Button fx:id="day1" styleClass="calendar-day" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button fx:id="day2" styleClass="calendar-day" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button fx:id="day3" styleClass="calendar-day" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <Button fx:id="day4" styleClass="calendar-day" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                <Button fx:id="day5" styleClass="calendar-day" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                                <Button fx:id="day6" styleClass="calendar-day" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                                <Button fx:id="day7" styleClass="calendar-day" GridPane.columnIndex="6" GridPane.rowIndex="0"/>

                                <!-- Row 2 -->
                                <Button fx:id="day8" styleClass="calendar-day" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Button fx:id="day9" styleClass="calendar-day" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Button fx:id="day10" styleClass="calendar-day" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <Button fx:id="day11" styleClass="calendar-day" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                <Button fx:id="day12" styleClass="calendar-day" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                                <Button fx:id="day13" styleClass="calendar-day" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                                <Button fx:id="day14" styleClass="calendar-day" GridPane.columnIndex="6" GridPane.rowIndex="1"/>

                                <!-- Row 3 -->
                                <Button fx:id="day15" styleClass="calendar-day" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Button fx:id="day16" styleClass="calendar-day" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                <Button fx:id="day17" styleClass="calendar-day" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                <Button fx:id="day18" styleClass="calendar-day" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                <Button fx:id="day19" styleClass="calendar-day" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                                <Button fx:id="day20" styleClass="calendar-day" GridPane.columnIndex="5" GridPane.rowIndex="2"/>
                                <Button fx:id="day21" styleClass="calendar-day" GridPane.columnIndex="6" GridPane.rowIndex="2"/>

                                <!-- Row 4 -->
                                <Button fx:id="day22" styleClass="calendar-day" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Button fx:id="day23" styleClass="calendar-day" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                <Button fx:id="day24" styleClass="calendar-day" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                                <Button fx:id="day25" styleClass="calendar-day" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                                <Button fx:id="day26" styleClass="calendar-day" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
                                <Button fx:id="day27" styleClass="calendar-day" GridPane.columnIndex="5" GridPane.rowIndex="3"/>
                                <Button fx:id="day28" styleClass="calendar-day" GridPane.columnIndex="6" GridPane.rowIndex="3"/>

                            </children>
                        </GridPane>

                        <!-- Planner Card (CENTERED UNDER GRID) -->
                        <VBox styleClass="planner-card" spacing="14.0" alignment="CENTER_LEFT">
                            <children>

                                <Label fx:id="plannerDateLabel"
                                       text="Wed • Mar 26 — tap a day"
                                       styleClass="planner-date-label"/>

                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label prefWidth="72.0" styleClass="field-label" text="Language" />
                                        <ComboBox fx:id="studyLanguageCombo" maxWidth="Infinity" styleClass="question-language-combo" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label prefWidth="72.0" styleClass="field-label" text="Focus" />
                                        <ComboBox fx:id="studyTopicCombo" maxWidth="Infinity" styleClass="question-language-combo" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label prefWidth="72.0" styleClass="field-label" text="Level" />
                                        <ComboBox fx:id="studyLevelCombo" maxWidth="Infinity" styleClass="question-language-combo" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label fx:id="warmupLabel" styleClass="planner-main-line" text="Warm-up" />
                                        <Label fx:id="warmupSummaryLabel" styleClass="planner-sub-line" wrapText="true" />
                                        <VBox fx:id="warmupLinksVBox" spacing="6.0" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label fx:id="coreLabel" styleClass="planner-main-line" text="Core" />
                                        <Label fx:id="coreSummaryLabel" styleClass="planner-sub-line" wrapText="true" />
                                        <VBox fx:id="coreLinksVBox" spacing="6.0" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label fx:id="stretchLabel" styleClass="planner-main-line" text="Stretch" />
                                        <Label fx:id="stretchSummaryLabel" styleClass="planner-sub-line" wrapText="true" />
                                        <VBox fx:id="stretchLinksVBox" spacing="6.0" />
                                    </children>
                                </VBox>

                            </children>

                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>

                            <VBox.margin>
                                <Insets left="24.0" right="24.0"/>
                            </VBox.margin>
                        </VBox>

                            </children>
                            <padding>
                                <Insets bottom="24.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Bottom Navigation -->
                <HBox alignment="CENTER" spacing="18.0" styleClass="nav-bar">
                    <children>

                        <Button onAction="#navLeaderboard" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg"
                                         content="M7 4h10v2H7V4Zm-2 4h14v2H5V8Zm2 4h10v2H7v-2Zm-2 4h14v2H5v-2Z"/>
                            </graphic>
                        </Button>

                        <Button onAction="#navCalendar" styleClass="nav-icon nav-icon-active">
                            <graphic>
                                <SVGPath styleClass="nav-svg"
                                         content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7Zm12 8H5v10h14V10Z"/>
                            </graphic>
                        </Button>

                        <Button onAction="#navHome" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg"
                                         content="M12 3 3 10h2v9h6v-6h2v6h6v-9h2L12 3Z"/>
                            </graphic>
                        </Button>

                        <Button onAction="#navHelp" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg"
                                         content="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"/>
                            </graphic>
                        </Button>

                        <Button onAction="#navProfile" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg"
                                         content="M12 12a4 4 0 1 0-0.001-8A4 4 0 0 0 12 12Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z"/>
                            </graphic>
                        </Button>

                    </children>

                    <padding>
                        <Insets top="8.0" right="10.0" bottom="12.0" left="10.0"/>
                    </padding>
                </HBox>

            </children>
        </VBox>
    </children>
</StackPane>

