<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane styleClass="screen-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.ProgressController">

    <children>
        <VBox spacing="0">
            <children>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="home-scroll"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="18" styleClass="home-content">
                            <padding>
                                <Insets top="22" right="22" bottom="22" left="22"/>
                            </padding>

                            <children>
                                <!-- top toggle -->
                                <HBox alignment="CENTER" spacing="12">
                                    <children>
                                        <Button mnemonicParsing="false"
                                                onAction="#openLeaderboard"
                                                styleClass="leaderboard-tab"
                                                text="Leaderboard" />
                                        <Button mnemonicParsing="false"
                                                onAction="#navProgress"
                                                styleClass="leaderboard-tab-active"
                                                text="Your progress" />
                                    </children>
                                </HBox>

                                <!-- stat cards -->
                                <HBox alignment="CENTER" spacing="10">
                                    <children>
                                        <VBox alignment="CENTER"
                                              prefWidth="104"
                                              spacing="6"
                                              styleClass="progress-stat-card">
                                            <children>
                                                <Label fx:id="streakValueLabel"
                                                       text="0"
                                                       styleClass="progress-stat-value"/>
                                                <Label text="Streak"
                                                       styleClass="progress-stat-label"/>
                                            </children>
                                            <padding>
                                                <Insets top="14" right="10" bottom="14" left="10"/>
                                            </padding>
                                        </VBox>

                                        <VBox alignment="CENTER"
                                              prefWidth="104"
                                              spacing="6"
                                              styleClass="progress-stat-card">
                                            <children>
                                                <Label fx:id="solvedValueLabel"
                                                       text="0"
                                                       styleClass="progress-stat-value"/>
                                                <Label text="Solved"
                                                       styleClass="progress-stat-label"/>
                                            </children>
                                            <padding>
                                                <Insets top="14" right="10" bottom="14" left="10"/>
                                            </padding>
                                        </VBox>

                                        <VBox alignment="CENTER"
                                              prefWidth="104"
                                              spacing="6"
                                              styleClass="progress-stat-card">
                                            <children>
                                                <Label fx:id="badgesValueLabel"
                                                       text="0"
                                                       styleClass="progress-stat-value"/>
                                                <Label text="Badges"
                                                       styleClass="progress-stat-label"/>
                                            </children>
                                            <padding>
                                                <Insets top="14" right="10" bottom="14" left="10"/>
                                            </padding>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- badges -->
                                <VBox spacing="10">
                                    <children>
                                        <Label text="Badges earned" styleClass="section-title"/>
                                        <FlowPane fx:id="badgesPane"
                                                  hgap="10"
                                                  vgap="10"
                                                  prefWrapLength="320"
                                                  styleClass="progress-badges-pane"/>
                                    </children>
                                </VBox>

                                <!-- completed questions -->
                                <VBox spacing="10" styleClass="progress-section-card">
                                    <children>
                                        <Label text="Completed questions" styleClass="section-title"/>
                                        <VBox fx:id="completedQuestionsList" spacing="8"/>
                                    </children>
                                    <padding>
                                        <Insets top="14" right="14" bottom="14" left="14"/>
                                    </padding>
                                </VBox>

                                <!-- favorite questions -->
                                <VBox spacing="10" styleClass="progress-section-card">
                                    <children>
                                        <Label text="Favorite questions" styleClass="section-title"/>
                                        <VBox fx:id="favoriteQuestionsList" spacing="8"/>
                                    </children>
                                    <padding>
                                        <Insets top="14" right="14" bottom="14" left="14"/>
                                    </padding>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER" spacing="18" styleClass="nav-bar">
                    <children>
                        <Button mnemonicParsing="false" onAction="#navLeaderboard" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M7 4h10v2H7V4Zm-2 4h14v2H5V8Zm2 4h10v2H7v-2Zm-2 4h14v2H5v-2Z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#navCalendar" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7Zm12 8H5v10h14V10Z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#navHome" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M12 3 3 10h2v9h6v-6h2v6h6v-9h2L12 3Z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#navHelp" styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M12 2a10 10 0 1 0 .001 20A10 10 0 0 0 12 2Zm0 15a1.25 1.25 0 1 1 0 2.5A1.25 1.25 0 0 1 12 17Zm1.2-3.8v1.1h-2.4v-1.9c0-1.4.8-2.1 1.8-2.7.8-.5 1.4-.9 1.4-1.7 0-.9-.7-1.5-1.7-1.5-1 0-1.7.6-1.8 1.6H8.1c.1-2.2 1.9-3.7 4.3-3.7 2.5 0 4.2 1.4 4.2 3.5 0 1.8-1.2 2.7-2.2 3.3-.7.4-1.2.8-1.2 2Z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#navProfile" styleClass="nav-icon nav-icon-active">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M12 12a4 4 0 1 0-0.001-8A4 4 0 0 0 12 12Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z" />
                            </graphic>
                        </Button>
                    </children>
                    <padding>
                        <Insets top="10" right="18" bottom="10" left="18"/>
                    </padding>
                </HBox>

            </children>
        </VBox>
    </children>
</StackPane>