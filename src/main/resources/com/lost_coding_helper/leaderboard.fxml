<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane styleClass="screen-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controllers.LeaderboardController">

    <children>
        <VBox spacing="0">
            <children>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            styleClass="home-scroll"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="18" styleClass="home-content">
                            <padding>
                                <Insets top="22" right="22" bottom="22" left="22"/>
                            </padding>

                            <children>
                                <HBox alignment="CENTER" spacing="12">
                                    <children>
                                        <Button mnemonicParsing="false"
                                                onAction="#navLeaderboard"
                                                styleClass="leaderboard-tab-active"
                                                text="Leaderboard" />
                                        <Button mnemonicParsing="false"
                                                onAction="#openProgress"
                                                styleClass="leaderboard-tab"
                                                text="Your progress" />
                                    </children>
                                </HBox>

                                <HBox alignment="BOTTOM_CENTER" spacing="12" styleClass="podium-row">
                                    <children>

                                        <VBox fx:id="secondPlaceCard"
                                              alignment="TOP_CENTER"
                                              prefWidth="92"
                                              prefHeight="185"
                                              minHeight="185"
                                              maxHeight="185"
                                              spacing="6"
                                              styleClass="podium-card podium-silver">
                                            <children>
                                                <Label text="#2" styleClass="podium-rank-label"/>
                                                <Label fx:id="secondPlaceName"
                                                       text="silver_user"
                                                       styleClass="podium-name"
                                                       wrapText="true"/>
                                                <Region VBox.vgrow="ALWAYS"/>
                                                <Label fx:id="secondPlaceValue"
                                                       text="0 days"
                                                       styleClass="podium-value"/>
                                            </children>
                                            <padding>
                                                <Insets top="14" right="10" bottom="14" left="10"/>
                                            </padding>
                                        </VBox>

                                        <VBox fx:id="firstPlaceCard"
                                              alignment="TOP_CENTER"
                                              prefWidth="102"
                                              prefHeight="235"
                                              minHeight="235"
                                              maxHeight="235"
                                              spacing="6"
                                              styleClass="podium-card podium-gold">
                                            <children>
                                                <Label text="#1" styleClass="podium-rank-label"/>
                                                <Label fx:id="firstPlaceName"
                                                       text="gold_user"
                                                       styleClass="podium-name"
                                                       wrapText="true"/>
                                                <Region VBox.vgrow="ALWAYS"/>
                                                <Label fx:id="firstPlaceValue"
                                                       text="0 days"
                                                       styleClass="podium-value"/>
                                            </children>
                                            <padding>
                                                <Insets top="14" right="10" bottom="14" left="10"/>
                                            </padding>
                                        </VBox>

                                        <VBox fx:id="thirdPlaceCard"
                                              alignment="TOP_CENTER"
                                              prefWidth="92"
                                              prefHeight="150"
                                              minHeight="150"
                                              maxHeight="150"
                                              spacing="6"
                                              styleClass="podium-card podium-bronze">
                                            <children>
                                                <Label text="#3" styleClass="podium-rank-label"/>
                                                <Label fx:id="thirdPlaceName"
                                                       text="bronze_user"
                                                       styleClass="podium-name"
                                                       wrapText="true"/>
                                                <Region VBox.vgrow="ALWAYS"/>
                                                <Label fx:id="thirdPlaceValue"
                                                       text="0 days"
                                                       styleClass="podium-value"/>
                                            </children>
                                            <padding>
                                                <Insets top="14" right="10" bottom="14" left="10"/>
                                            </padding>
                                        </VBox>

                                    </children>
                                </HBox>

                                <VBox spacing="10">
                                    <children>
                                        <Label text="Global rankings" styleClass="section-title"/>
                                        <VBox fx:id="leaderboardList" spacing="8"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER" spacing="18" styleClass="nav-bar">
                    <children>
                        <Button mnemonicParsing="false"
                                focusTraversable="false"
                                onAction="#navLeaderboard"
                                styleClass="nav-icon nav-icon-active">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M7 4h10v2H7V4Zm-2 4h14v2H5V8Zm2 4h10v2H7v-2Zm-2 4h14v2H5v-2Z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false"
                                focusTraversable="false"
                                onAction="#navCalendar"
                                styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7Zm12 8H5v10h14V10Z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false"
                                focusTraversable="false"
                                onAction="#navHome"
                                styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M12 3 3 10h2v9h6v-6h2v6h6v-9h2L12 3Z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false"
                                focusTraversable="false"
                                onAction="#navHelp"
                                styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z" />
                            </graphic>
                        </Button>

                        <Button mnemonicParsing="false"
                                focusTraversable="false"
                                onAction="#navProfile"
                                styleClass="nav-icon">
                            <graphic>
                                <SVGPath styleClass="nav-svg" content="M12 12a4 4 0 1 0-0.001-8A4 4 0 0 0 12 12Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z" />
                            </graphic>
                        </Button>
                    </children>
                    <padding>
                        <Insets top="10" right="18" bottom="10" left="18"/>
                    </padding>
                </HBox>

            </children>
        </VBox>
    </children>
</StackPane>