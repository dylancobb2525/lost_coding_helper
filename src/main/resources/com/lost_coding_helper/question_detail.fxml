<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane styleClass="screen-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.QuestionDetailController">
   <children>
      <VBox spacing="0.0">
         <children>
            <BorderPane VBox.vgrow="ALWAYS">
               <center>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll" BorderPane.alignment="CENTER">
                     <content>
                        <VBox spacing="14.0" styleClass="question-tab-root">
                           <children>
                              <Button mnemonicParsing="false" onAction="#backToQuestions" styleClass="button-pill-outline button-small" text="← Back to questions" />
                              <Label fx:id="questionTitleLabel" styleClass="title-section" text="Question" wrapText="true" />
                              <Label fx:id="questionMetaLabel" styleClass="card-meta" text="Difficulty: Easy" />
                              <Label fx:id="questionTopicsLabel" styleClass="hint-muted" text="Topics: None" wrapText="true" />
                              <Label fx:id="questionCompaniesLabel" styleClass="hint-muted" text="Companies: None" wrapText="true" />
                              <Label text="Prompt" styleClass="section-title" />
                              <Label fx:id="questionPromptLabel" styleClass="question-prompt" text="Prompt text" wrapText="true" />
                              <Label text="Your solution" styleClass="section-title" />
                              <Label styleClass="field-label" text="Language" />
                              <ComboBox fx:id="languageCombo" maxWidth="Infinity" styleClass="question-language-combo" />
                              <TextArea fx:id="solutionCodeArea" prefRowCount="9" promptText="Write your solution here…" styleClass="question-editor" wrapText="true" />
                              <Button mnemonicParsing="false" onAction="#saveMySolution" styleClass="button-pill-outline" text="Save my solution" />
                              <Button fx:id="favoriteButton" mnemonicParsing="false" onAction="#toggleFavorite" styleClass="button-pill-outline" text="Add to favorites" />
                              <Button mnemonicParsing="false" onAction="#markComplete" styleClass="button-pill-primary" text="Mark complete" />
                              <Label fx:id="completionStatusLabel" managed="false" styleClass="hint-muted" text="" visible="false" wrapText="true" />
                              <VBox spacing="12.0" styleClass="official-solution-spoiler">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <Label styleClass="official-solution-heading" text="Official solution" wrapText="false" />
                                          <Region prefWidth="0.0" HBox.hgrow="ALWAYS" />
                                          <Button fx:id="toggleOfficialSolutionButton" mnemonicParsing="false" onAction="#toggleOfficialSolutionReveal" styleClass="button-pill-outline button-small" text="Show ▼" />
                                       </children>
                                    </HBox>
                                    <VBox fx:id="officialSolutionsRevealPanel" managed="false" spacing="10.0" visible="false">
                                       <children>
                                          <VBox fx:id="providedSolutionsContainer" spacing="10.0" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets bottom="20.0" left="22.0" right="22.0" top="22.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </center>
               <bottom>
                  <VBox fx:id="commentsDockRoot" spacing="0.0" styleClass="question-comments-dock">
                     <children>
                        <HBox fx:id="commentsCollapsedStrip" alignment="CENTER_LEFT" spacing="12.0" styleClass="comments-collapsed-strip">
                           <children>
                              <Label fx:id="commentsCollapsedTitle" styleClass="section-title" text="Comments" />
                              <Label fx:id="commentsCollapsedCount" styleClass="hint-muted" text="" wrapText="false" />
                              <Region prefWidth="0.0" HBox.hgrow="ALWAYS" />
                              <Button fx:id="expandCommentsButton" mnemonicParsing="false" onAction="#expandCommentsDock" styleClass="button-pill-outline button-small" text="Show ▲" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="22.0" right="22.0" top="10.0" />
                           </padding>
                        </HBox>
                        <VBox fx:id="commentsExpandedPanel" managed="false" spacing="10.0" styleClass="question-comments-expanded" visible="false">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <Label styleClass="section-title" text="Comments" />
                                    <Region prefWidth="0.0" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="collapseCommentsButton" mnemonicParsing="false" onAction="#collapseCommentsDock" styleClass="button-pill-outline button-small" text="Hide ▼" />
                                 </children>
                              </HBox>
                              <ScrollPane fx:id="commentsScrollPane" fitToWidth="true" hbarPolicy="NEVER" minHeight="80.0" prefViewportHeight="160.0" styleClass="home-scroll" VBox.vgrow="ALWAYS">
                                 <content>
                                    <VBox fx:id="commentsListContainer" spacing="8.0">
                                       <padding>
                                          <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                                       </padding>
                                    </VBox>
                                 </content>
                              </ScrollPane>
                              <TextArea fx:id="commentInputArea" prefRowCount="3" promptText="Write a comment…" styleClass="question-editor" wrapText="true" />
                              <Button fx:id="postCommentButton" mnemonicParsing="false" onAction="#postQuestionComment" styleClass="button-pill-outline" text="Post comment" />
                           </children>
                           <padding>
                              <Insets bottom="14.0" left="22.0" right="22.0" top="10.0" />
                           </padding>
                        </VBox>
                     </children>
                  </VBox>
               </bottom>
            </BorderPane>
            <HBox alignment="CENTER" spacing="18.0" styleClass="nav-bar">
               <children>
                  <Button mnemonicParsing="false" onAction="#navLeaderboard" styleClass="nav-icon">
                     <graphic>
                        <SVGPath styleClass="nav-svg" content="M7 4h10v2H7V4Zm-2 4h14v2H5V8Zm2 4h10v2H7v-2Zm-2 4h14v2H5v-2Z" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#navCalendar" styleClass="nav-icon">
                     <graphic>
                        <SVGPath styleClass="nav-svg" content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7Zm12 8H5v10h14V10Z" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#navHome" styleClass="nav-icon">
                     <graphic>
                        <SVGPath styleClass="nav-svg" content="M12 3 3 10h2v9h6v-6h2v6h6v-9h2L12 3Z" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#navHelp" styleClass="nav-icon nav-icon-active">
                     <graphic>
                        <SVGPath styleClass="nav-svg" content="M12 2a10 10 0 1 0 .001 20A10 10 0 0 0 12 2Zm0 15a1.25 1.25 0 1 1 0 2.5A1.25 1.25 0 0 1 12 17Zm1.2-3.8v1.1h-2.4v-1.9c0-1.4.8-2.1 1.8-2.7.8-.5 1.4-.9 1.4-1.7 0-.9-.7-1.5-1.7-1.5-1 0-1.7.6-1.8 1.6H8.1c.1-2.2 1.9-3.7 4.3-3.7 2.5 0 4.2 1.4 4.2 3.5 0 1.8-1.2 2.7-2.2 3.3-.7.4-1.2.8-1.2 2Z" />
                     </graphic>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#navProfile" styleClass="nav-icon">
                     <graphic>
                        <SVGPath styleClass="nav-svg" content="M12 12a4 4 0 1 0-0.001-8A4 4 0 0 0 12 12Zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5Z" />
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
